@functions {
    private static readonly string Bootstrap = JGUZDV.PasskeyAuth.InlineResourceLoader.LoadStyle("jg-ootstrap.css");
    private static readonly string App = JGUZDV.PasskeyAuth.InlineResourceLoader.LoadStyle("app.css");
}
<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
        <title>Passkey-Authentifizierung</title>
        <base href="/" />

        <link rel="icon" href="img/JGU-Quader.ico" />
        <link rel="icon" sizes="16x16 32x32 64x64" href="img/JGU-Quader.ico">
        <link rel="icon" sizes="180x180" href="img/JGU-Quader-180.png">

        <style>@Html.Raw(Bootstrap)</style>
        <link href="css/font-awesome/css/all.min.css" rel="stylesheet" />
        <style>@Html.Raw(App)</style>

        @RenderSection("HeadContent", required: false)
    </head>
    <body data-automatic-sign-in="@ViewData["automaticSignIn"]">
        <div class="content">
            <div class="imgs">
                <img src="img/logo_uni-mainz_grey.svg" class="brand" />
                <img src="img/FIDO_Passkey_mark_A.png" alt="passkeyLogo" class="logo" />
            </div>
            @RenderBody()
        </div>
    </body>
</html>
